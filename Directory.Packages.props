<Project>
	<!--
		Central Package Management. Project files reference packages WITHOUT a Version attribute.
		Rule: the newest version that is at least two weeks old on the day it is added, verified against
		api.nuget.org. Day 1: 23 Oct 2026 (cut-off 9 Oct). Groups for later days (persistence, AI) are added on the day
		they are first needed, with that day's verification.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<!-- Dates: sales happen on local dates, and named periods ("last quarter") are calendar arithmetic. NodaTime 3.3.6
	     is from 22 Oct, so 3.3.5 (30 Sep 2026), Apache-2.0. -->
	<ItemGroup Label="Time">
		<PackageVersion Include="NodaTime" Version="3.3.5" />
		<PackageVersion Include="NodaTime.Testing" Version="3.3.5" />
	</ItemGroup>

	<!--
		Npgsql 10.0.3 (27 May 2026) and its EF Core provider and NodaTime plugin 10.0.3 (10 Jul 2026), PostgreSQL licence:
		datasets are loaded with COPY, their description lives in EF Core tables. Day 2 (26 Oct 2026, cut-off 12 Oct): EF
		Core 10.0.13 is from 13 Oct and 10.0.14 from 25 Oct, so 10.0.12 (8 Sep), MIT; EFCore.NamingConventions 10.0.1
		(22 Jan 2026), Apache-2.0.
	-->
	<ItemGroup Label="Persistence">
		<PackageVersion Include="Npgsql" Version="10.0.3" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
		<PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
		<!-- Day 2: the API's JSON for NodaTime types, ISO 8601. 1.4.0 (6 Jun 2026), Apache-2.0. -->
		<PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
	</ItemGroup>

	<!--
		ClosedXML 0.105.1 (25 Jul 2026), MIT: the sample's Excel files, and reading uploaded ones. CsvHelper 33.1.0
		(2 Jun 2025), MS-PL or Apache-2.0: uploaded CSV files.
	-->
	<ItemGroup Label="Spreadsheets">
		<PackageVersion Include="ClosedXML" Version="0.105.1" />
		<PackageVersion Include="CsvHelper" Version="33.1.0" />
	</ItemGroup>

	<!-- Microsoft.Extensions: 10.0.14 (25 Oct), the minimum Aspire 13.6.5 needs (11 Nov 2026); 10.11.0 is from 14 Oct, so
	     10.10.0 (9 Sep). OpenTelemetry 1.20.x is from 20-21 Oct. MIT and Apache-2.0. -->
	<ItemGroup Label="Hosting and observability">
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
		<!-- Day 4: the evals build the app's services from an in-memory configuration. -->
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
		<PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
	</ItemGroup>

	<!--
		Day 5 (26 Oct 2026, cut-off 12 Oct): the official Anthropic SDK, 13.x is from 21 Oct on, so 12.54.1 (8 Oct), MIT,
		the version booking-agent runs.
	-->
	<ItemGroup Label="AI">
		<PackageVersion Include="Anthropic" Version="12.54.1" />
	</ItemGroup>

	<!-- The AppHost SDK version (13.6.5, a security exception explained below) is in the AppHost project file. -->
	<ItemGroup Label="Aspire">
		<!--
			Security exception to the two-week rule (11 Nov 2026): CVE-2026-120006 (GHSA-f7vh-h5g3-7jrh, high, 10 Nov)
			affects Aspire.Hosting and Aspire.Hosting.AppHost below 13.6.5: the dashboard's auth cookie can reach a
			linked container, which can replay it and run code as the developer (macOS). The SDK and these
			integrations move to the fix, 13.6.5 (10 Nov), which becomes an ordinary version on 24 Nov. It brings
			MessagePack 2.5.307 itself, so the transitive pin for GHSA-qhrr-8q5h-9q3h is gone.
		-->
		<PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
		<PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
	</ItemGroup>

	<!--
		Day 4 (26 Oct 2026, cut-off 12 Oct): FsCheck 3.6.0 is from 21 Oct, so 3.4.0 (20 Aug 2026), BSD-3-Clause, for the
		compiler's property-based tests.
	-->
	<ItemGroup Label="Property-based testing">
		<PackageVersion Include="FsCheck" Version="3.4.0" />
	</ItemGroup>

	<!--
		xUnit stays on the v2 line: TngTech.ArchUnitNET.xUnit depends on xunit.assert 2.x, and
		xunit.runner.visualstudio 3.1.5 is the last v2-compatible runner. Microsoft.NET.Test.Sdk 18.11.0 is from
		13 Oct, so 18.10.1. Testcontainers 4.16.0 (8 Oct 2026), MIT.
	-->
	<ItemGroup Label="Testing">
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
		<PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
		<PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.4" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
	</ItemGroup>
</Project>
